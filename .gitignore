# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# WebAssembly build output
core/bindings/wasm/pkg/
apps/web/src/wasm/

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Agent skill symlinks (machine-local Windows junctions; regenerate with `npx skills add`)
.claude/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
secrets.json
keystore.properties

# Android
apps/android/local.properties
apps/android/.gradle/
apps/android/build/
apps/android/*/build/
apps/android/.kotlin/
*.apk
*.aab
.cxx/

# iOS
# The Xcode project is generated from apps/ios/project.yml by XcodeGen; a
# pbxproj is build output and is never committed.
apps/ios/*.xcodeproj/
apps/ios/*.xcworkspace/
apps/ios/Generated/
apps/ios/Frameworks/
apps/ios/DerivedData/
# Simulator run for the store screenshots: derived data and result bundles. The
# PNGs themselves land in brand/app-store/screenshots/ and are committed.
apps/ios/.screenshots/
xcuserdata/
*.xcresult
*.ipa
*.dSYM.zip

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
logs/
*.log
npm-debug.log*

# Store screenshot scratch: raw unframed captures, written by
# tools/store-shots/capture.mjs --raw while iterating on a shot.
tools/store-shots/.raw/

# APM dependencies
apm_modules/
