  {
    "id": "redirect-shortener-benign-quiet",
    "payload": "https://bit.ly/abc",
    "redirectResolution": {
      "chain": [
        { "url": "https://bit.ly/abc", "status": 301, "via": "http_status" },
        { "url": "https://ekte-nettbutikk.example/produkt", "status": 200 }
      ],
      "finalUrl": "https://ekte-nettbutikk.example/produkt",
      "outcome": "resolved",
      "elapsedMs": 22,
      "resolver": "qrrrgh-resolver/1"
    },
    "expectedVerdict": "insufficient_evidence",
    "expectedFindings": ["url.shortener"],
    "mustNotContain": [
      "redirect.cross_domain",
      "redirect.multiple_hops",
      "redirect.excessive_hops",
      "limitation.redirect_not_expanded",
      "limitation.redirect_partial"
    ],
    "notes": "The common case: a shortener that expands to a benign destination must stay quiet. cross_domain is suppressed for shortener origins, and the offline 'not expanded' limitation is cleared because the chain WAS expanded. A false positive here would train users to ignore the product."
  },
