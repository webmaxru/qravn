<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand neutrals. The launcher icon is bone on night petrol in either mode,
    because the icon is one fixed object and it should look the same wherever
    it is pinned.

    The splash is different: it has to match the window it is about to become,
    or the app opens with a flash. So splash_background and mark_ink follow
    day/night. Colour beyond these neutrals is reserved for verdicts; see
    ui/theme/Theme.kt.
-->
<resources>
    <color name="ic_launcher_background">#0C1519</color>
    <color name="splash_background">#FAFAF8</color>
    <color name="mark_ink">#0C1519</color>
</resources>
