<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash mark. Same geometry as the launcher foreground, but the fill follows
    the day/night colour so the mark stays legible on either splash background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="6.4"
        android:scaleY="6.4"
        android:translateX="31.6"
        android:translateY="31.6">
        <path
            android:fillColor="@color/mark_ink"
            android:fillType="evenOdd"
            android:pathData="M0,0 H7 V5.5 H6 V1 H1 V6 H5.5 V7 H0 Z M2,2 H5 V5 H2 Z" />
    </group>
</vector>
