<?xml version="1.0" encoding="utf-8"?>
<!--
    The brand mark: one QR finder pattern with the ring left open at the
    bottom right. See brand/mark.svg for the canonical geometry and why the
    ring never closes.

    Bone on a night ground, matching the launcher background in colors.xml.

    The 7 module field is drawn at 0..7 and mapped into the 108dp adaptive
    icon viewport by the group transform. Android scales first, then
    translates, so 0..7 becomes 31.6..76.4, centred on 54. The furthest corner
    sits 31.7 units from the centre, inside the 33 unit radius every launcher
    mask is guaranteed to show, so nothing can be clipped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="6.4"
        android:scaleY="6.4"
        android:translateX="31.6"
        android:translateY="31.6">
        <path
            android:fillColor="#F1EDE6"
            android:fillType="evenOdd"
            android:pathData="M0,0 H7 V5.5 H6 V1 H1 V6 H5.5 V7 H0 Z M2,2 H5 V5 H2 Z" />
    </group>
</vector>
