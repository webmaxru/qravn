<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick Settings tile. The brand mark at tile scale, so the tile, the
    launcher icon and the splash are all the same glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <group
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:translateX="0.75"
        android:translateY="0.75">
        <path
            android:fillColor="@android:color/white"
            android:fillType="evenOdd"
            android:pathData="M0,0 H7 V7 H0 Z M1,1 H6 V6 H1 Z M2,2 H5 V5 H2 Z" />
        <path
            android:fillColor="@android:color/white"
            android:fillType="evenOdd"
            android:pathData="M8,0 H15 V7 H8 Z M9,1 H14 V6 H9 Z M10,2 H13 V5 H10 Z" />
        <path
            android:fillColor="@android:color/white"
            android:fillType="evenOdd"
            android:pathData="M0,8 H7 V15 H0 Z M1,9 H6 V14 H1 Z M2,10 H5 V13 H2 Z" />
    </group>
</vector>
