<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing this app stores is worth transferring. Scan history does not exist,
    and the handful of UI preferences are cheap to set again. Excluding
    everything keeps a security app out of cloud backups entirely.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
